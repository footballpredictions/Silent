# ============================
#   Silent VPN — .env config
# ============================

# App
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
APP_NAME=Silent VPN

# Database
POSTGRES_PASSWORD=change_postgres_password
REDIS_PASSWORD=change_redis_password

# JWT
JWT_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX

# Admin panel
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# MFA: код входа на почту (пусто = MFA выключен).
# Админка: ADMIN_PUBLIC_HOST (публичный) + Host 10.66.66.1 (VPN tunnel).
ADMIN_MFA_EMAIL=silent27@bk.ru
ADMIN_PUBLIC_HOST=132-243-234-162.nip.io
ADMIN_SESSION_HOURS=12
ADMIN_MFA_CODE_TTL_MINUTES=2

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@your-domain.ru
EMAIL_FROM_NAME=Silent VPN

# YuMoney
YUMONEY_WALLET_1=your_first_yumoney_wallet
YUMONEY_WALLET_2=your_second_yumoney_wallet
YUMONEY_SECRET=your_yumoney_notification_secret

# VPN Server
VPN_SERVER_IP=your_server_ip
VPN_SERVER_PORT=56000
HIVE_CPU_PERCENT_THRESHOLD=85
HIVE_MEM_PERCENT_THRESHOLD=88
HIVE_WORKER_ROUTING_ENABLED=false
HIVE_CAPACITY_SAMPLE_INTERVAL_SEC=30
HIVE_CAPACITY_MIN_SAMPLES=5
HIVE_CAPACITY_MIN_ONLINE_FOR_LEARN=1
HIVE_CAPACITY_PEAK_ACTIVE_SHARE=0.10

# VK Community bot (config delivery when API blocked)
VK_GROUP_ID=239092728
VK_COMMUNITY_TOKEN=your_community_token_with_messages
VK_BOT_WRITE_URL=https://vk.com/write-239092728

# VK ID (user account linking)
VK_ID_APP_ID=54610377
VK_ID_CLIENT_SECRET=your_vk_id_secure_key
VK_ID_REDIRECT_URI=https://132-243-234-162.nip.io/api/auth/vk/callback

# VK AI agent — Android access_token (calls.start)
# Вариант A (рекомендуется): VK Звонки silent_token, app calls.vk.com (7793118)
# Секрет опционален — anonym token для 7793118 работает без него
VK_CALLS_CLIENT_SECRET=
# Вариант B: готовый токен vk1.a… (получить через OAuth Kate Mobile или VK Звонки)
VK_AGENT_ACCESS_TOKEN=
# Вариант C: логин/пароль (часто блокируется VK flood control на 3–6 ч)
VK_LOGIN=
VK_PASSWORD=
WDTT_MASTER_PASSWORD=CHANGE_ME_STRONG_VPN_PASSWORD
WDTT_PORT=56000
WDTT_WG_PORT=56001

# GitHub Releases — публикация на silentvpn3.github.io (лендинг + скачивание без VPS)
# PAT: Contents (read/write) + Releases на silentvpn3/silentvpn3.github.io
GITHUB_TOKEN=
# GITHUB_RELEASES_OWNER=silentvpn3
# GITHUB_RELEASES_REPO=silentvpn3.github.io

PRICE_MONTHLY=199.0
PRICE_QUARTERLY=499.0
PRICE_YEARLY=1499.0
