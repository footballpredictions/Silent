def cmd_competitors_off(_: list[str]) -> None:
    """Перед Silent-туннелем: quit/kill чужих VPN (не поднимаем их обратно на down)."""
    hit: list[str] = []
    for name in COMPETITOR_PROCESS_NAMES:
        with contextlib.suppress(Exception):
            run(
                ["osascript", "-e", f'tell application "{name}" to quit'],
                check=False,
                capture=True,
            )
        p = run(["killall", "-TERM", name], check=False, capture=True)
        if p.returncode == 0:
            hit.append(name)
    time.sleep(0.35)
    for name in COMPETITOR_PROCESS_NAMES:
        p = run(["killall", "-KILL", name], check=False, capture=True)
        if p.returncode == 0:
            hit.append(name)
    seen: list[str] = []
    for x in hit:
        if x not in seen:
            seen.append(x)
    print("OK competitors-off " + (",".join(seen) if seen else "noop"))


