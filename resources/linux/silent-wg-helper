#!/usr/bin/env python3
"""Privileged WireGuard helper for Silent VPN on Linux.

Must run as root. After .deb install a systemd unit keeps `serve` running,
so the GUI talks to a unix socket and never asks for a password.

Commands:

  serve
  up <conf> <wireguard-go-or-auto> [--subnet]
  down
  status
  gateway
  bypass-add <gw> <iface> <cidr> [cidr...]
  bypass-del <cidr> [cidr...]
  dns-set <ifname> <dns1>[,dns2...]
  dns-restore
  hosts-pin <ip:hostname> [ip:hostname...]
  hosts-restore
  protect-on <gw> <iface>
  protect-off
  ipv6-block
  ipv6-restore

Tunnel name is always wg-turn — same as Windows.
Routing matches Windows PC: AllowedIPs 0.0.0.0/1 + 128.0.0.0/1 (full)
or 10.66.66.0/24 (bootstrap). Bypass /32 via physical gateway.
"""
from __future__ import annotations

import base64
import contextlib
import io
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

IFACE = "wg-turn"
RUN_DIR = "/run/silent-vpn"
PID_FILE = os.path.join(RUN_DIR, "wireguard-go.pid")
SOCK_PATH = f"/var/run/wireguard/{IFACE}.sock"
HELPER_SOCK = os.path.join(RUN_DIR, "helper.sock")
RESOLV_BAK = os.path.join(RUN_DIR, "resolv.conf.bak")
DNS_STATE = os.path.join(RUN_DIR, "dns-state.json")
HOSTS_MARK_BEGIN = "# silent-vpn-hosts-begin"
HOSTS_MARK_END = "# silent-vpn-hosts-end"
# Android-like protect(): WDTT SO_MARK → this table (мимо wg-turn).
LAN_PROTECT_MARK = "0x53494c"
LAN_PROTECT_TABLE = "7349"
LAN_PROTECT_PREF = "100"
IPV6_STATE = os.path.join(RUN_DIR, "ipv6-state.json")
STATE_FILE = os.path.join(RUN_DIR, "state")
_IPV4 = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$")
_CIDR = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?$")
_IFACE = re.compile(r"^[A-Za-z0-9_.:-]{1,15}$")
_HOST = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,253}$")
_HOST_PAIR = re.compile(
    r"^((?:\d{1,3}\.){3}\d{1,3}):([A-Za-z0-9][A-Za-z0-9._-]{0,253})$"
)


def die(msg: str, code: int = 1) -> None:
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


def need_root() -> None:
    if os.geteuid() != 0:
        die("need root (pkexec/sudo)", 77)


def run(cmd: list[str], check: bool = True, capture: bool = False, timeout: int = 30):
    return subprocess.run(
        cmd,
        check=check,
        capture_output=capture,
        text=True,
        timeout=timeout,
    )


def run_out(cmd: list[str], timeout: int = 15) -> str:
    try:
        p = run(cmd, check=False, capture=True, timeout=timeout)
        return ((p.stdout or "") + (p.stderr or "")).strip()
    except Exception:
        return ""


def list_other_ifaces(skip: str) -> list[str]:
    out: list[str] = []
    try:
        for name in os.listdir("/sys/class/net"):
            if name in (skip, "lo") or name.startswith("docker") or name.startswith("veth"):
                continue
            if name.startswith("br-") or name.startswith("virbr"):
                continue
            out.append(name)
    except OSError:
        pass
    return out


def save_dns_state(other: list[str]) -> None:
    os.makedirs(RUN_DIR, exist_ok=True)
    payload = {"other": other, "ts": time.time()}
    with open(DNS_STATE, "w", encoding="utf-8") as f:
        json.dump(payload, f)


def load_dns_state() -> list[str]:
    try:
        with open(DNS_STATE, "r", encoding="utf-8") as f:
            data = json.load(f)
        other = data.get("other") or []
        return [str(x) for x in other if isinstance(x, str)]
    except (OSError, json.JSONDecodeError, TypeError):
        return []


def clear_dns_state() -> None:
    with contextlib.suppress(OSError):
        os.remove(DNS_STATE)

def parse_conf(path: str) -> dict:
    data: dict = {
        "private_key": "",
        "address": "",
        "dns": [],
        "mtu": "1200",
        "public_key": "",
        "endpoint": "",
        "allowed_ips": [],
        "keepalive": "25",
    }
    section = ""
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip().lower()
                continue
            if "=" not in line:
                continue
            key, val = line.split("=", 1)
            key = key.strip().lower().replace(" ", "")
            val = val.strip()
            if key == "privatekey":
                data["private_key"] = val
            elif key == "address":
                data["address"] = val.split(",")[0].strip()
            elif key == "dns":
                data["dns"] = [x.strip() for x in re.split(r"[,;\s]+", val) if x.strip()]
            elif key == "mtu":
                data["mtu"] = val
            elif key == "publickey":
                data["public_key"] = val
            elif key == "endpoint":
                data["endpoint"] = val
            elif key == "allowedips":
                data["allowed_ips"] = [x.strip() for x in val.split(",") if x.strip()]
            elif key == "persistentkeepalive":
                data["keepalive"] = val
    if not data["private_key"] or not data["public_key"] or not data["address"]:
        die("invalid wg conf: missing keys/address")
    if not data["allowed_ips"]:
        data["allowed_ips"] = ["0.0.0.0/1", "128.0.0.0/1"]
    return data


def b64_to_hex(s: str) -> str:
    raw = base64.b64decode(s.strip())
    if len(raw) != 32:
        die(f"wg key must be 32 bytes, got {len(raw)}")
    return raw.hex()


def uapi_set(conf: dict) -> None:
    body = [
        "set=1",
        f"private_key={b64_to_hex(conf['private_key'])}",
        "replace_peers=true",
        f"public_key={b64_to_hex(conf['public_key'])}",
        f"endpoint={conf['endpoint']}",
        f"persistent_keepalive_interval={conf['keepalive']}",
    ]
    for ip in conf["allowed_ips"]:
        body.append(f"allowed_ip={ip}")
    payload = "\n".join(body) + "\n\n"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(5)
        sock.connect(SOCK_PATH)
        sock.sendall(payload.encode("ascii"))
        reply = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            reply += chunk
            if b"\n\n" in reply:
                break
    finally:
        sock.close()
    text = reply.decode("ascii", errors="replace")
    if "errno=0" not in text:
        die(f"wireguard uapi failed: {text.strip()[:400]}")


def iface_exists() -> bool:
    return os.path.exists(f"/sys/class/net/{IFACE}")


def iface_up() -> bool:
    p = f"/sys/class/net/{IFACE}/operstate"
    if not os.path.exists(p):
        p = f"/sys/class/net/{IFACE}/flags"
        if not os.path.exists(p):
            return False
        try:
            flags = int(open(p, encoding="utf-8").read().strip(), 16)
            return bool(flags & 0x1)
        except Exception:
            return False
    try:
        st = open(p, encoding="utf-8").read().strip().lower()
        return st in ("up", "unknown")
    except Exception:
        return False


def kill_wg_go() -> None:
    pid = None
    if os.path.isfile(PID_FILE):
        try:
            pid = int(open(PID_FILE, encoding="utf-8").read().strip())
        except Exception:
            pid = None
    if pid:
        try:
            os.kill(pid, 15)
            for _ in range(20):
                try:
                    os.kill(pid, 0)
                    time.sleep(0.1)
                except OSError:
                    break
            else:
                os.kill(pid, 9)
        except OSError:
            pass
        try:
            os.remove(PID_FILE)
        except OSError:
            pass
    run(["pkill", "-f", f"wireguard-go.*{IFACE}"], check=False)
    if iface_exists():
        run(["ip", "link", "delete", "dev", IFACE], check=False)


def start_userspace(wg_go: str) -> None:
    os.makedirs("/var/run/wireguard", exist_ok=True)
    os.makedirs(RUN_DIR, exist_ok=True)
    proc = subprocess.Popen(
        [wg_go, IFACE],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    with open(PID_FILE, "w", encoding="utf-8") as f:
        f.write(str(proc.pid))
    for _ in range(50):
        if os.path.exists(SOCK_PATH) and iface_exists():
            return
        time.sleep(0.1)
    die("wireguard-go did not create interface/socket")


def start_kernel() -> None:
    run(["ip", "link", "add", "dev", IFACE, "type", "wireguard"], check=True)
    if shutil.which("wg") is None:
        die("kernel wireguard needs the 'wg' tool (wireguard-tools)")


def apply_kernel_conf(conf: dict) -> None:
    tmp = os.path.join(RUN_DIR, "wg.setconf")
    os.makedirs(RUN_DIR, exist_ok=True)
    lines = [
        "[Interface]",
        f"PrivateKey = {conf['private_key']}",
        "[Peer]",
        f"PublicKey = {conf['public_key']}",
        f"Endpoint = {conf['endpoint']}",
        f"AllowedIPs = {', '.join(conf['allowed_ips'])}",
        f"PersistentKeepalive = {conf['keepalive']}",
        "",
    ]
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    os.chmod(tmp, 0o600)
    run(["wg", "setconf", IFACE, tmp], check=True)


def apply_addr_routes(conf: dict) -> None:
    addr = conf["address"]
    if "/" not in addr:
        addr = addr + "/32"
    run(["ip", "address", "flush", "dev", IFACE], check=False)
    run(["ip", "address", "add", addr, "dev", IFACE], check=True)
    mtu = str(conf.get("mtu") or "1200")
    run(["ip", "link", "set", "dev", IFACE, "mtu", mtu, "up"], check=True)
    for net in conf["allowed_ips"]:
        run(["ip", "-4", "route", "replace", net, "dev", IFACE], check=False)


def cmd_up(args: list[str]) -> None:
    if len(args) < 1:
        die("up <conf> [wireguard-go|auto] [--subnet]")
    conf_path = args[0]
    wg_go = args[1] if len(args) > 1 and not args[1].startswith("-") else "auto"
    if not os.path.isfile(conf_path):
        die(f"conf not found: {conf_path}")
    conf = parse_conf(conf_path)
    os.makedirs(RUN_DIR, exist_ok=True)
    kill_wg_go()
    time.sleep(0.2)

    userspace = None
    if wg_go and wg_go not in ("auto", "kernel", "-"):
        if os.path.isfile(wg_go) and os.access(wg_go, os.X_OK):
            userspace = wg_go
    if userspace is None and wg_go == "auto":
        cand = shutil.which("wireguard-go")
        if cand:
            userspace = cand

    use_kernel = False
    if userspace:
        start_userspace(userspace)
        uapi_set(conf)
    else:
        # kernel module
        try:
            run(["modprobe", "wireguard"], check=False)
        except Exception:
            pass
        if not os.path.exists("/sys/module/wireguard") and not os.path.exists(
            "/sys/class/net"
        ):
            die("no wireguard-go binary and no kernel wireguard")
        start_kernel()
        apply_kernel_conf(conf)
        use_kernel = True

    apply_addr_routes(conf)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        f.write("kernel\n" if use_kernel else "userspace\n")
    print("OK up", IFACE)


def cmd_down(_: list[str]) -> None:
    cmd_dns_restore([])
    kill_wg_go()
    print("OK down")


def cmd_status(_: list[str]) -> None:
    up = iface_exists() and iface_up()
    print("up" if up else "down")
    sys.exit(0 if up else 1)


def cmd_gateway(_: list[str]) -> None:
    # ip -4 route show default
    p = run(["ip", "-4", "route", "show", "default"], check=False, capture=True)
    text = (p.stdout or "").strip()
    gw = ""
    iface = ""
    m = re.search(r"via\s+(\d+\.\d+\.\d+\.\d+)", text)
    if m:
        gw = m.group(1)
    m = re.search(r"dev\s+(\S+)", text)
    if m:
        iface = m.group(1)
        if iface == IFACE:
            # already tunneled — try remaining defaults
            for line in text.splitlines():
                if IFACE in line:
                    continue
                m2 = re.search(r"via\s+(\d+\.\d+\.\d+\.\d+)", line)
                m3 = re.search(r"dev\s+(\S+)", line)
                if m2 and m3:
                    gw, iface = m2.group(1), m3.group(1)
                    break
    if not gw or not iface:
        die("no physical default gateway")
    print(f"{gw} {iface}")


def cmd_bypass_add(args: list[str]) -> None:
    if len(args) < 3:
        die("bypass-add <gw> <iface> <cidr> [cidr...]")
    gw, iface = args[0], args[1]
    ok = 0
    for cidr in args[2:]:
        dest = cidr if "/" in cidr else cidr + "/32"
        p = run(
            ["ip", "-4", "route", "replace", dest, "via", gw, "dev", iface, "metric", "1"],
            check=False,
            capture=True,
        )
        if p.returncode == 0:
            ok += 1
    if ok < 1:
        die("bypass-add failed")
    print(f"OK bypass {ok}")


def cmd_bypass_del(args: list[str]) -> None:
    for cidr in args:
        dest = cidr if "/" in cidr else cidr + "/32"
        run(["ip", "-4", "route", "del", dest], check=False)
    print("OK bypass-del")


def _chattr_i(path: str, enable: bool) -> None:
    chattr = shutil.which("chattr")
    if not chattr or not os.path.exists(path):
        return
    flag = "+i" if enable else "-i"
    run([chattr, flag, path], check=False)


def cmd_dns_set(args: list[str]) -> None:
    if len(args) < 2:
        die("dns-set <ifname> <dns,dns>")
    ifname = args[0]
    servers = [x.strip() for x in re.split(r"[,;\s]+", args[1]) if x.strip()]
    if not servers:
        return

    # Always pin /etc/resolv.conf to VPN DNS. Stub 127.0.0.53 often keeps DHCP
    # upstreams (8.8.8.8 on wifi) → i/o timeout while WG is "up".
    # Never leave 8.8.8.8 as nameserver — on some Wi‑Fi it times out via LAN too.
    os.makedirs(RUN_DIR, exist_ok=True)
    if os.path.exists("/etc/resolv.conf") and not os.path.exists(RESOLV_BAK):
        try:
            if os.path.islink("/etc/resolv.conf"):
                with open(RESOLV_BAK, "w", encoding="utf-8") as f:
                    f.write("SYMLINK:" + os.readlink("/etc/resolv.conf") + "\n")
            else:
                shutil.copy2("/etc/resolv.conf", RESOLV_BAK)
        except OSError:
            pass
    lines = ["# silent-vpn\n", "options timeout:2 attempts:2\n"] + [
        f"nameserver {s}\n" for s in servers
    ]
    try:
        _chattr_i("/etc/resolv.conf", False)
        if os.path.islink("/etc/resolv.conf") or os.path.exists("/etc/resolv.conf"):
            os.remove("/etc/resolv.conf")
        with open("/etc/resolv.conf", "w", encoding="utf-8") as f:
            f.writelines(lines)
        _chattr_i("/etc/resolv.conf", True)
        print("OK dns resolv.conf " + ",".join(servers))
    except OSError as e:
        print(f"WARN dns resolv.conf: {e}")

    if shutil.which("resolvectl"):
        run(["resolvectl", "dns", ifname, *servers], check=False)
        run(["resolvectl", "domain", ifname, "~."], check=False)
        run(["resolvectl", "default-route", ifname, "yes"], check=False)
        others = list_other_ifaces(ifname)
        save_dns_state(others)
        for other in others:
            run(["resolvectl", "default-route", other, "no"], check=False)
            run(["resolvectl", "dns", other], check=False)
            run(["resolvectl", "domain", other], check=False)
        run(["resolvectl", "flush-caches"], check=False)
        print("OK dns resolvectl demote=" + ",".join(others))


def cmd_dns_restore(_: list[str]) -> None:
    others = load_dns_state()
    if shutil.which("resolvectl"):
        if iface_exists():
            run(["resolvectl", "revert", IFACE], check=False)
        for other in others or list_other_ifaces(IFACE):
            run(["resolvectl", "revert", other], check=False)
        run(["resolvectl", "flush-caches"], check=False)
    _chattr_i("/etc/resolv.conf", False)
    if os.path.isfile(RESOLV_BAK):
        try:
            raw = open(RESOLV_BAK, "r", encoding="utf-8", errors="replace").read()
            if raw.startswith("SYMLINK:"):
                target = raw.split(":", 1)[1].strip()
                with contextlib.suppress(OSError):
                    os.remove("/etc/resolv.conf")
                os.symlink(target, "/etc/resolv.conf")
            else:
                shutil.copy2(RESOLV_BAK, "/etc/resolv.conf")
            os.remove(RESOLV_BAK)
        except OSError:
            with contextlib.suppress(OSError):
                if not os.path.exists("/etc/resolv.conf"):
                    os.symlink("/run/systemd/resolve/stub-resolv.conf", "/etc/resolv.conf")
    clear_dns_state()
    print("OK dns-restore")


def _strip_hosts_block(text: str) -> str:
    out_lines: list[str] = []
    skip = False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped == HOSTS_MARK_BEGIN:
            skip = True
            continue
        if stripped == HOSTS_MARK_END:
            skip = False
            continue
        if not skip:
            out_lines.append(line)
    return "".join(out_lines)


def cmd_hosts_pin(args: list[str]) -> None:
    pairs: list[tuple[str, str]] = []
    for raw in args:
        m = _HOST_PAIR.match(raw.strip())
        if not m:
            die(f"bad hosts pair: {raw}")
        pairs.append((m.group(1), m.group(2)))
    if not pairs:
        return
    path = "/etc/hosts"
    try:
        prev = open(path, "r", encoding="utf-8", errors="replace").read()
    except OSError as e:
        die(f"hosts read: {e}")
    base = _strip_hosts_block(prev).rstrip() + "\n"
    block = [HOSTS_MARK_BEGIN + "\n"]
    seen: set[tuple[str, str]] = set()
    for ip, host in pairs:
        key = (ip, host)
        if key in seen:
            continue
        seen.add(key)
        block.append(f"{ip} {host}\n")
    block.append(HOSTS_MARK_END + "\n")
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(base)
            if not base.endswith("\n"):
                f.write("\n")
            f.writelines(block)
        print(f"OK hosts-pin n={len(seen)}")
    except OSError as e:
        die(f"hosts write: {e}")


def cmd_hosts_restore(_: list[str]) -> None:
    path = "/etc/hosts"
    try:
        prev = open(path, "r", encoding="utf-8", errors="replace").read()
    except OSError as e:
        print(f"WARN hosts-restore: {e}")
        return
    if HOSTS_MARK_BEGIN not in prev:
        print("OK hosts-restore noop")
        return
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(_strip_hosts_block(prev))
        print("OK hosts-restore")
    except OSError as e:
        print(f"WARN hosts-restore: {e}")


def cmd_protect_on(args: list[str]) -> None:
    """Policy routing for WDTT SO_MARK — аналог Android VpnService.protect()."""
    if len(args) < 2:
        die("protect-on <gw> <iface>")
    gw, iface = args[0], args[1]
    if not _IPV4.match(gw) or not _IFACE.match(iface):
        die("invalid gw/iface")
    # Clear previous
    for _ in range(3):
        run(
            ["ip", "rule", "del", "fwmark", LAN_PROTECT_MARK, "lookup", LAN_PROTECT_TABLE],
            check=False,
        )
    run(["ip", "route", "flush", "table", LAN_PROTECT_TABLE], check=False)
    p = run(
        ["ip", "route", "replace", "default", "via", gw, "dev", iface, "table", LAN_PROTECT_TABLE],
        check=False,
        capture=True,
    )
    if p.returncode != 0:
        die(f"protect-on route: {(p.stderr or p.stdout or '').strip()}")
    # Connected LAN routes so local gateway works
    link = run_out(["ip", "-4", "route", "show", "dev", iface, "scope", "link"])
    for line in link.splitlines():
        parts = line.split()
        if not parts:
            continue
        run(["ip", "route", "replace", *parts, "table", LAN_PROTECT_TABLE], check=False)
    run(
        [
            "ip",
            "rule",
            "add",
            "fwmark",
            LAN_PROTECT_MARK,
            "lookup",
            LAN_PROTECT_TABLE,
            "priority",
            LAN_PROTECT_PREF,
        ],
        check=False,
    )
    print(f"OK protect-on mark={LAN_PROTECT_MARK} via {gw} dev {iface}")


def cmd_protect_off(_: list[str]) -> None:
    for _ in range(3):
        run(
            ["ip", "rule", "del", "fwmark", LAN_PROTECT_MARK, "lookup", LAN_PROTECT_TABLE],
            check=False,
        )
    run(["ip", "route", "flush", "table", LAN_PROTECT_TABLE], check=False)
    print("OK protect-off")


def _ipv6_ra_keys() -> list[str]:
    keys = [
        "net.ipv6.conf.all.accept_ra",
        "net.ipv6.conf.default.accept_ra",
    ]
    for iface in list_other_ifaces(IFACE):
        if iface in ("lo", "docker0"):
            continue
        keys.append(f"net.ipv6.conf.{iface}.accept_ra")
    return keys


def cmd_ipv6_block(_: list[str]) -> None:
    """IPv4-only tunnel without sysctl disable_ipv6 (NM иначе орёт «нет интернета»).

    Blackhole IPv6 default + stop RA — браузер сразу берёт IPv4 через WG.
    """
    os.makedirs(RUN_DIR, exist_ok=True)
    state: dict = {"sysctl": {}, "blackhole": False}
    if not os.path.exists(IPV6_STATE):
        for key in _ipv6_ra_keys():
            prev = run_out(["sysctl", "-n", key])
            if prev != "":
                state["sysctl"][key] = prev.strip().split("\n")[-1].strip()
        try:
            with open(IPV6_STATE, "w", encoding="utf-8") as f:
                json.dump(state, f)
        except OSError:
            pass
    # Не трогаем disable_ipv6 — ломает NM/Firefox offline detection.
    for key in _ipv6_ra_keys():
        run(["sysctl", "-w", f"{key}=0"], check=False)
    # Снести живые IPv6 default с wifi/eth (RA мог вернуть)
    defs = run_out(["ip", "-6", "route", "show", "default"])
    for line in defs.splitlines():
        if "blackhole" in line or not line.strip():
            continue
        # ip -6 route del default via ... dev ...
        parts = line.split()
        run(["ip", "-6", "route", "del", *parts], check=False)
    p = run(
        ["ip", "-6", "route", "replace", "blackhole", "default", "metric", "1"],
        check=False,
        capture=True,
    )
    if p.returncode == 0 or "File exists" in ((p.stderr or "") + (p.stdout or "")):
        try:
            raw = open(IPV6_STATE, "r", encoding="utf-8").read() if os.path.isfile(IPV6_STATE) else "{}"
            st = json.loads(raw or "{}")
            st["blackhole"] = True
            # Keep first-saved sysctl; merge ra keys if missing
            if not st.get("sysctl"):
                st["sysctl"] = state.get("sysctl") or {}
            with open(IPV6_STATE, "w", encoding="utf-8") as f:
                json.dump(st, f)
        except Exception:
            pass
    print("OK ipv6-block blackhole")


def cmd_ipv6_restore(_: list[str]) -> None:
    st: dict = {}
    if os.path.isfile(IPV6_STATE):
        try:
            st = json.loads(open(IPV6_STATE, "r", encoding="utf-8").read() or "{}")
        except Exception:
            st = {}
    if st.get("blackhole"):
        run(["ip", "-6", "route", "del", "blackhole", "default", "metric", "1"], check=False)
        run(["ip", "-6", "route", "del", "blackhole", "default"], check=False)
    for key, val in (st.get("sysctl") or {}).items():
        if re.match(r"^-?\d+$", str(val)):
            run(["sysctl", "-w", f"{key}={val}"], check=False)
    # Fail-safe: allow RA again
    if not st.get("sysctl"):
        for key in _ipv6_ra_keys():
            run(["sysctl", "-w", f"{key}=1"], check=False)
    # Legacy: если старый ipv6-block выставлял disable_ipv6=1 — вернуть 0
    for key in (
        "net.ipv6.conf.all.disable_ipv6",
        "net.ipv6.conf.default.disable_ipv6",
    ):
        cur = run_out(["sysctl", "-n", key]).strip()
        if cur == "1" and key not in (st.get("sysctl") or {}):
            run(["sysctl", "-w", f"{key}=0"], check=False)
    with contextlib.suppress(OSError):
        os.remove(IPV6_STATE)
    print("OK ipv6-restore")

COMMANDS = {
    "up": cmd_up,
    "down": cmd_down,
    "status": cmd_status,
    "gateway": cmd_gateway,
    "bypass-add": cmd_bypass_add,
    "bypass-del": cmd_bypass_del,
    "dns-set": cmd_dns_set,
    "dns-restore": cmd_dns_restore,
    "hosts-pin": cmd_hosts_pin,
    "hosts-restore": cmd_hosts_restore,
    "protect-on": cmd_protect_on,
    "protect-off": cmd_protect_off,
    "ipv6-block": cmd_ipv6_block,
    "ipv6-restore": cmd_ipv6_restore,
}


def conf_path_ok(path: str) -> bool:
    try:
        ap = os.path.realpath(path).replace("\\", "/")
    except OSError:
        return False
    if not ap.endswith(".conf"):
        return False
    return (
        "/.local/share/SilentVPN/" in ap
        or ap.startswith("/tmp/")
        or ap.startswith("/var/tmp/")
        or ap.startswith("/opt/silent-vpn/")
        or ap.startswith("/run/silent-vpn/")
    )


def wg_go_path_ok(path: str) -> bool:
    if not path or path in ("auto", "kernel", "-"):
        return True
    try:
        ap = os.path.realpath(path)
    except OSError:
        return False
    if os.path.basename(ap) != "wireguard-go":
        return False
    return (
        ap.startswith("/opt/silent-vpn/")
        or ap.startswith("/tmp/.mount_")
        or ap.startswith("/usr/bin/")
        or ap.startswith("/usr/local/bin/")
    )


def validate_args(args: list[str]) -> str | None:
    if not args:
        return "empty command"
    cmd = args[0]
    if cmd not in COMMANDS:
        return f"unknown command: {cmd}"
    rest = args[1:]
    if cmd == "up":
        if not rest:
            return "up needs conf"
        if not conf_path_ok(rest[0]):
            return "conf path not allowed"
        if len(rest) > 1 and not wg_go_path_ok(rest[1]):
            return "wireguard-go path not allowed"
    elif cmd == "bypass-add":
        if len(rest) < 3:
            return "bypass-add needs gw iface cidr"
        if not _IPV4.match(rest[0]) or not _IFACE.match(rest[1]):
            return "invalid gw/iface"
        if not all(_CIDR.match(x) for x in rest[2:]):
            return "invalid cidr"
    elif cmd == "bypass-del":
        if not rest or not all(_CIDR.match(x) for x in rest):
            return "invalid cidr"
    elif cmd == "dns-set":
        if len(rest) < 2 or rest[0] != IFACE:
            return "dns-set only for wg-turn"
        servers = [x.strip() for x in re.split(r"[,;\s]+", rest[1]) if x.strip()]
        if not servers or not all(_IPV4.match(s) for s in servers):
            return "invalid dns"
    elif cmd == "hosts-pin":
        if not rest:
            return "hosts-pin needs pairs"
        if not all(_HOST_PAIR.match(x.strip()) for x in rest):
            return "invalid hosts pair"
    elif cmd == "hosts-restore":
        pass
    elif cmd == "protect-on":
        if len(rest) < 2:
            return "protect-on needs gw iface"
        if not _IPV4.match(rest[0]) or not _IFACE.match(rest[1]):
            return "invalid gw/iface"
    elif cmd == "protect-off":
        pass
    elif cmd in ("ipv6-block", "ipv6-restore"):
        pass
    return None


def run_command(args: list[str]) -> tuple[int, str, str]:
    err = validate_args(args)
    if err:
        return 2, "", err
    out_buf = io.StringIO()
    err_buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(out_buf), contextlib.redirect_stderr(err_buf):
            COMMANDS[args[0]](args[1:])
        return 0, out_buf.getvalue(), err_buf.getvalue()
    except SystemExit as e:
        code = 0 if e.code in (0, None) else (e.code if isinstance(e.code, int) else 1)
        return code, out_buf.getvalue(), err_buf.getvalue()
    except Exception as e:
        return 1, out_buf.getvalue(), str(e)


def handle_client(conn: socket.socket) -> None:
    conn.settimeout(120)
    buf = b""
    try:
        while b"\n" not in buf:
            chunk = conn.recv(4096)
            if not chunk:
                return
            buf += chunk
            if len(buf) > 1_000_000:
                return
    except OSError:
        return
    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        return
    try:
        req = json.loads(line.decode("utf-8"))
        args = req.get("args")
        if not isinstance(args, list) or not all(isinstance(x, str) for x in args):
            raise ValueError("args")
        if len(args) > 128:
            raise ValueError("too many args")
    except Exception:
        payload = json.dumps({"ok": False, "code": 2, "out": "", "err": "bad request"}) + "\n"
        try:
            conn.sendall(payload.encode("utf-8"))
        except OSError:
            pass
        return
    code, out, err = run_command(args)
    payload = json.dumps({"ok": code == 0, "code": code, "out": out, "err": err}) + "\n"
    try:
        conn.sendall(payload.encode("utf-8"))
    except OSError:
        pass


def cmd_serve(_: list[str]) -> None:
    need_root()
    os.makedirs(RUN_DIR, exist_ok=True)
    try:
        os.remove(HELPER_SOCK)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(HELPER_SOCK)
    os.chmod(HELPER_SOCK, 0o666)
    srv.listen(8)
    while True:
        try:
            conn, _ = srv.accept()
        except OSError:
            continue
        try:
            handle_client(conn)
        finally:
            try:
                conn.close()
            except OSError:
                pass


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        die(
            "silent-wg-helper <serve|up|down|status|gateway|"
            "bypass-add|bypass-del|dns-set|dns-restore> ..."
        )
    cmd = sys.argv[1]
    if cmd == "serve":
        cmd_serve([])
        return
    need_root()
    fn = COMMANDS.get(cmd)
    if not fn:
        die(f"unknown command: {cmd}")
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
