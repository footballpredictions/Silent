#!/bin/sh
# Local JSON face for the web UI. Hive tokens stay on the router.

SV_LIB="/usr/lib/silent-vpn"
. "$SV_LIB/common.sh"
. "$SV_LIB/hive.sh"
. "$SV_LIB/session.sh"

sv_mkdir

read_body() {
	if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
		dd bs="$CONTENT_LENGTH" count=1 2>/dev/null
	fi
}

json_out() {
	echo "Status: $1"
	echo "Content-Type: application/json; charset=utf-8"
	echo "Cache-Control: no-store"
	echo
	shift
	printf '%s\n' "$*"
}

if ! sv_http_allow_lan; then
	json_out 403 '{"detail":"Панель доступна по Wi-Fi или кабелю в сети роутера. Если на телефоне или ПК включён Silent VPN — отключите его и откройте http://IP_роутера"}'
	exit 0
fi

OP="$(echo "${PATH_INFO:-}" | sed 's#^/##')"
[ -n "$OP" ] || OP="$(echo "${QUERY_STRING:-}" | sed -n 's/.*op=\([^&]*\).*/\1/p')"
[ -n "$OP" ] || OP="$(echo "${REQUEST_URI:-}" | sed -n 's|.*/silent-api/||p' | cut -d'?' -f1 | tr -d '/')"

BODY="$(read_body)"

if [ -d "$SV_RUN/update.lock" ] && [ -f "$SV_LIB/update.sh" ]; then
	. "$SV_LIB/update.sh"
	case "$OP:$REQUEST_METHOD" in
		connect:*|disconnect:*|logout:*|server:POST|exclusions:POST|dns:POST)
			if sv_update_busy; then
				json_out 409 '{"detail":"Дождитесь завершения обновления"}'
				exit 0
			fi ;;
	esac
fi

email_of() { printf '%s' "$BODY" | jsonfilter -e '@.email' 2>/dev/null || true; }
pass_of() { printf '%s' "$BODY" | jsonfilter -e '@.password' 2>/dev/null || true; }
code_of() { printf '%s' "$BODY" | jsonfilter -e '@.referral_or_promo' 2>/dev/null || true; }

require_session() {
	if ! sv_session_active; then
		json_out 401 '{"detail":"Войдите в аккаунт"}'
		exit 0
	fi
}

case "$OP" in
	update-check|update-status)
		json_out 200 "$(/usr/sbin/silent-vpn-update "${OP#update-}")"
		;;
	update-start)
		if [ "$REQUEST_METHOD" != POST ] || ! sv_session_active; then
			json_out 403 '{"detail":"Войдите в аккаунт для обновления"}'
		elif [ -n "${HTTP_ORIGIN:-}" ] && [ "$HTTP_ORIGIN" != "http://$HTTP_HOST" ] && [ "$HTTP_ORIGIN" != "https://$HTTP_HOST" ]; then
			json_out 403 '{"detail":"Откройте панель роутера заново"}'
		else
			json_out 200 "$(/usr/sbin/silent-vpn-update start)"
		fi
		;;
	status)
		json_out 200 "$(silent-vpn-ctl status)"
		;;
	theme)
		f="$(sv_hive_theme)"
		json_out 200 "$(cat "$f" 2>/dev/null)"
		;;
	login)
		f="$(sv_hive_login "$(email_of)" "$(pass_of)")" || true
		token="$(jsonfilter -i "$f" -e '@.access_token' 2>/dev/null || true)"
		case "$token" in
			*.*.*) ;;
			*) token="" ;;
		esac
		me=""
		pemail=""
		if [ -n "$token" ]; then
			sv_hive_register_device >/dev/null 2>&1 || true
			me="$(sv_hive_me)"
			pemail="$(jsonfilter -i "$me" -e '@.email' 2>/dev/null || true)"
		fi
		if [ -n "$token" ] && [ -n "$pemail" ]; then
			rn="$(sv_router_name | sed 's/"/\\"/g')"
			json_out 200 "$(printf '{"email":"%s","lan_ip":"%s","lan_url":"%s","router_name":"%s","profile":%s,"connected":%s}' \
				"$pemail" "$(sv_lan_ip)" "$(sv_lan_url)" "$rn" "$(cat "$me")" \
				"$(sv_session_connected && echo true || echo false)")"
		else
			rm -f "$SV_VAR/access_token" "$SV_VAR/refresh_token"
			if [ -n "$token" ]; then
				detail="Сервер не отдал данные аккаунта"
			else
				detail="$(jsonfilter -i "$f" -e '@.detail' 2>/dev/null || true)"
				[ -n "$detail" ] || detail="Неверный email или пароль"
			fi
			detail="$(printf '%s' "$detail" | tr -d '"\\' | cut -c 1-180)"
			sv_log "login rejected: $detail"
			# 200, not 401: uhttpd drops a 401 body, and the form then shows nothing.
			json_out 200 "$(printf '{"ok":false,"detail":"%s"}' "$detail")"
		fi
		;;
	register)
		f="$(sv_hive_register "$(email_of)" "$(pass_of)" "$(code_of)")"
		json_out 200 "$(cat "$f")"
		;;
	forgot)
		f="$(sv_hive_forgot "$(email_of)")"
		json_out 200 "$(cat "$f")"
		;;
	logout)
		# Keep VPN up; only drop Hive tokens. Browser clears its own panel unlock.
		sv_panel_logout
		if sv_session_connected; then
			json_out 200 '{"ok":true,"connected":true}'
		else
			json_out 200 '{"ok":true,"connected":false}'
		fi
		;;
	connect)
		require_session
		if sv_connect_full; then
			json_out 200 '{"ok":true,"connected":true}'
		else
			json_out 502 '{"detail":"Не удалось поднять туннель"}'
		fi
		;;
	log|log-clear)
		echo "Status: 200"
		echo "Content-Type: text/plain; charset=utf-8"
		echo "Cache-Control: no-store"
		echo
		echo "Лог отключён"
		;;
	disconnect)
		require_session
		if sv_disconnect_full; then
			json_out 200 '{"ok":true,"connected":false}'
		else
			json_out 500 '{"detail":"Не удалось полностью восстановить настройки сети. Повторите отключение VPN."}'
		fi
		;;
	profile)
		require_session
		f="$(sv_hive_me)"
		json_out 200 "$(cat "$f")"
		rm -f "$f"
		;;
	referral)
		require_session
		f="$(sv_hive_referral)"
		json_out 200 "$(cat "$f")"
		;;
	device-rename)
		require_session
		id="$(printf '%s' "$BODY" | jsonfilter -e '@.id' 2>/dev/null || true)"
		name="$(printf '%s' "$BODY" | jsonfilter -e '@.name' 2>/dev/null || true)"
		name="$(printf '%s' "$name" | tr -d '\r\n' | cut -c 1-64)"
		case "$id" in ""|*[!a-zA-Z0-9_-]*) json_out 400 '{"detail":"Некорректная сессия"}'; exit 0 ;; esac
		[ -n "$name" ] || name="Устройство"
		name_esc="$(printf '%s' "$name" | sed 's/\\/\\\\/g;s/"/\\"/g')"
		f="$(sv_hive_rename_device "$id" "$name_esc")"
		code="$(cat "$SV_RUN/http.code" 2>/dev/null || echo 502)"
		case "$code" in
			2*) json_out 200 "$(cat "$f")" ;;
			401) json_out 401 "$(cat "$f")" ;;
			*) json_out 502 "$(cat "$f")" ;;
		esac
		rm -f "$f"
		;;
	device-delete)
		require_session
		id="$(printf '%s' "$BODY" | jsonfilter -e '@.id' 2>/dev/null || true)"
		case "$id" in ""|*[!a-zA-Z0-9_-]*) json_out 400 '{"detail":"Некорректная сессия"}'; exit 0 ;; esac
		f="$(sv_hive_delete_device "$id")"
		code="$(cat "$SV_RUN/http.code" 2>/dev/null || echo 502)"
		case "$code" in
			2*) json_out 200 '{"ok":true}' ;;
			401) json_out 401 "$(cat "$f")" ;;
			*) json_out 502 "$(cat "$f")" ;;
		esac
		rm -f "$f"
		;;
	dns)
		if [ "$REQUEST_METHOD" = "POST" ]; then
			require_session
			preset="$(printf '%s' "$BODY" | jsonfilter -e '@.preset' 2>/dev/null || echo server)"
			custom="$(printf '%s' "$BODY" | jsonfilter -e '@.custom' 2>/dev/null || true)"
			silent-vpn-ctl set-dns "$preset" "$custom"
		fi
		json_out 200 "$(printf '{"preset":"%s","custom":"%s"}' \
			"$(uci -q get silent-vpn.main.dns_preset 2>/dev/null || echo server)" \
			"$(uci -q get silent-vpn.main.dns_custom 2>/dev/null || true)")"
		;;
	exclusions)
		if [ "$REQUEST_METHOD" = "POST" ]; then
			require_session
			on="$(printf '%s' "$BODY" | jsonfilter -e '@.ru_direct' 2>/dev/null)"
			if [ "$on" = "true" ] || [ "$on" = "1" ]; then
				on=1
			else
				on=0
			fi
			if ! silent-vpn-ctl ru-direct "$on"; then
				json_out 503 '{"detail":"Не удалось применить обход российских сервисов"}'
				exit 0
			fi
		fi
		json_out 200 "$(printf '{"ru_direct":%s}' \
			"$([ "$(uci -q get silent-vpn.main.ru_direct 2>/dev/null)" = 1 ] && echo true || echo false)")"
		;;
	servers)
		require_session
		f="$(sv_hive_servers)"
		if [ -s "$f" ]; then
			json_out 200 "$(cat "$f")"
		else
			json_out 200 '{"selected_server":"server1","servers":[]}'
		fi
		;;
	pay|pay-preview)
		require_session
		plan="$(printf '%s' "$BODY" | jsonfilter -e '@.plan_type' 2>/dev/null || echo monthly)"
		[ -n "$plan" ] || plan="monthly"
		if [ "$OP" = "pay-preview" ]; then
			f="$(sv_hive_post "/api/payments/preview" "$(printf '{"plan_type":"%s"}' "$plan")")"
		else
			f="$(sv_hive_pay "$plan")"
		fi
		if [ -s "$f" ]; then
			json_out 200 "$(cat "$f")"
		else
			json_out 502 '{"detail":"Не удалось начать оплату"}'
		fi
		;;
	pay-status)
		require_session
		label="$(printf '%s' "$BODY" | jsonfilter -e '@.label' 2>/dev/null)"
		case "$label" in silent_[a-f0-9]*) ;; *) json_out 400 '{"detail":"Некорректный платёж"}'; exit 0;; esac
		case "$label" in *[!a-z0-9_]*) json_out 400 '{"detail":"Некорректный платёж"}'; exit 0;; esac
		f="$(sv_hive_get "/api/payments/status/$label")"
		json_out 200 "$(cat "$f")"
		;;
	server)
		require_session
		key="$(printf '%s' "$BODY" | jsonfilter -e '@.key' 2>/dev/null || echo server1)"
		[ -n "$key" ] || key="server1"
		uci -q set silent-vpn.main.preferred_server="$key"
		uci -q commit silent-vpn
		sv_hive_register_device >/dev/null 2>&1 || true
		f="$(sv_hive_preferred "$key")"
		if [ -s "$f" ] && jsonfilter -i "$f" -e '@.selected_server' >/dev/null 2>&1; then
			json_out 200 "$(cat "$f")"
		else
			f="$(sv_hive_servers)"
			if [ -s "$f" ]; then
				json_out 200 "$(cat "$f")"
			else
				json_out 200 "$(printf '{"selected_server":"%s","servers":[]}' "$key")"
			fi
		fi
		;;
	promo)
		require_session
		code="$(printf '%s' "$BODY" | jsonfilter -e '@.code' 2>/dev/null || true)"
		code="$(printf '%s' "$code" | tr -d '\r\n"\\' | cut -c 1-64)"
		f="$(sv_hive_post "/api/payments/promo/check" "$(printf '{"code":"%s","plan_type":"monthly"}' "$code")")"
		json_out 200 "$(cat "$f")"
		rm -f "$f"
		;;
	*)
		json_out 404 '{"detail":"unknown op"}'
		;;
esac
