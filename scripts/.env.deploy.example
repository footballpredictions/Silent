# DEPLOY_WDTT_MASTER_PASSWORD=from_server_env

# OneDash API 2.0 (https://api.rdp-onedash.ru) — ключ только в Silent-Project/.env.deploy
# ONEDASH_API_KEY=
# ONEDASH_API_BASE=https://api.rdp-onedash.ru
# ONEDASH_PAID_ENABLED=false
# ONEDASH_CHANGE_IP_PATH=   # пусто: в публичных доках метода смены IP нет, POST не вызывать
