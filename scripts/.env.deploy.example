DEPLOY_CONTAINER=backend-api-1
# Если :22 Улья с РФ режут: прыжок ПК → сота:22 → Улей:22 (не :9100).
# DEPLOY_JUMP_HOSTS=87.58.213.193,78.17.74.27
# DEPLOY_JUMP_USER=root
# DEPLOY_JUMP_PASS=cell_ssh_password
