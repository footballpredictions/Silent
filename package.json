{
  "name": "silent-vpn-pc",
  "version": "1.0.153",
  "description": "Silent VPN PC Client",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --port 3001\" \"wait-on http://localhost:3001 && electron .\"",
    "build:renderer": "vite build --outDir dist/renderer",
    "build:renderer:debug": "vite build --mode debug --outDir dist/renderer",
    "build:debug": "build-debug.bat",
    "test": "node --test test/**/*.test.js",
    "build": "npm run build:installer",
    "build:installer": "build-installer.bat",
    "dist": "npm run build:installer"
  },
  "build": {
    "appId": "ru.silent.vpn",
    "productName": "Silent VPN",
    "directories": {
      "output": "build-release-v141"
    },
    "artifactName": "Silent VPN Setup ${version}.${ext}",
    "files": [
      "src/**",
      "dist/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/wdtt-client.exe",
        "to": "wdtt-client.exe"
      },
      {
        "from": "resources/wireguard",
        "to": "wireguard",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/wireguard-installer.msi",
        "to": "wireguard-installer.msi"
      },
      {
        "from": "assets/tray.png",
        "to": "assets/tray.png"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowElevation": true
    }
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  }
}
