#!/bin/sh
# Host-aware front door: *.silent.vpn → Silent UI, anything else → LuCI.

HOST="$(echo "${HTTP_HOST:-}" | tr 'A-Z' 'a-z' | cut -d: -f1)"
INDEX="/www/silent-vpn/index.html"

is_silent=0
case "$HOST" in
	silent.vpn|*.silent.vpn) is_silent=1 ;;
esac

if [ "$is_silent" -eq 1 ] && [ -f "$INDEX" ]; then
	echo "Status: 200 OK"
	echo "Content-Type: text/html; charset=utf-8"
	echo "Cache-Control: no-store"
	echo
	cat "$INDEX"
	exit 0
fi

if [ -x /www/cgi-bin/luci ]; then
	exec /www/cgi-bin/luci
fi

echo "Status: 404 Not Found"
echo "Content-Type: text/plain"
echo
echo "Silent VPN UI is not installed"
