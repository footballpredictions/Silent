#!/usr/bin/env python3
"""Privileged WireGuard helper for Silent VPN on macOS.

Same socket protocol as Linux helper. Run as root via LaunchDaemon after
install (password once), then GUI talks to unix socket without prompts.

On Darwin wireguard-go creates utunN (not a custom name). We store the
iface in /var/run/silent-vpn/iface.
"""
from __future__ import annotations

import base64
import contextlib
import io
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

RUN_DIR = "/var/run/silent-vpn"
PID_FILE = os.path.join(RUN_DIR, "wireguard-go.pid")
IFACE_FILE = os.path.join(RUN_DIR, "iface")
HELPER_SOCK = os.path.join(RUN_DIR, "helper.sock")
DNS_STATE = os.path.join(RUN_DIR, "dns-state.json")
IPV6_STATE = os.path.join(RUN_DIR, "ipv6-state.json")
STATE_FILE = os.path.join(RUN_DIR, "state")
HOSTS_MARK_BEGIN = "# silent-vpn-hosts-begin"
HOSTS_MARK_END = "# silent-vpn-hosts-end"
_IPV4 = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$")
_CIDR = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?$")
_IFACE = re.compile(r"^[A-Za-z0-9_.:-]{1,15}$")
_HOST_PAIR = re.compile(
    r"^((?:\d{1,3}\.){3}\d{1,3}):([A-Za-z0-9][A-Za-z0-9._-]{0,253})$"
)


def die(msg: str, code: int = 1) -> None:
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(code)


def need_root() -> None:
    if os.geteuid() != 0:
        die("need root (installer / LaunchDaemon)", 77)


def run(cmd: list[str], check: bool = True, capture: bool = False, timeout: int = 30):
    return subprocess.run(
        cmd,
        check=check,
        capture_output=capture,
        text=True,
        timeout=timeout,
    )


def run_out(cmd: list[str], timeout: int = 15) -> str:
    try:
        p = run(cmd, check=False, capture=True, timeout=timeout)
        return ((p.stdout or "") + (p.stderr or "")).strip()
    except Exception:
        return ""


def current_iface() -> str:
    try:
        return open(IFACE_FILE, encoding="utf-8").read().strip()
    except OSError:
        return ""


def set_iface(name: str) -> None:
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(IFACE_FILE, "w", encoding="utf-8") as f:
        f.write(name)


def sock_path(iface: str) -> str:
    return f"/var/run/wireguard/{iface}.sock"


def parse_conf(path: str) -> dict:
    data: dict = {
        "private_key": "",
        "address": "",
        "dns": [],
        "mtu": "1200",
        "public_key": "",
        "endpoint": "",
        "allowed_ips": [],
        "keepalive": "25",
    }
    section = ""
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip().lower()
                continue
            if "=" not in line:
                continue
            key, val = line.split("=", 1)
            key = key.strip().lower().replace(" ", "")
            val = val.strip()
            if key == "privatekey":
                data["private_key"] = val
            elif key == "address":
                data["address"] = val.split(",")[0].strip()
            elif key == "dns":
                data["dns"] = [x.strip() for x in re.split(r"[,;\s]+", val) if x.strip()]
            elif key == "mtu":
                data["mtu"] = val
            elif key == "publickey":
                data["public_key"] = val
            elif key == "endpoint":
                data["endpoint"] = val
            elif key == "allowedips":
                data["allowed_ips"] = [x.strip() for x in val.split(",") if x.strip()]
            elif key == "persistentkeepalive":
                data["keepalive"] = val
    if not data["private_key"] or not data["public_key"] or not data["address"]:
        die("invalid wg conf: missing keys/address")
    if not data["allowed_ips"]:
        data["allowed_ips"] = ["0.0.0.0/1", "128.0.0.0/1"]
    return data


def b64_to_hex(s: str) -> str:
    raw = base64.b64decode(s.strip())
    if len(raw) != 32:
        die(f"wg key must be 32 bytes, got {len(raw)}")
    return raw.hex()


def uapi_set(iface: str, conf: dict) -> None:
    body = [
        "set=1",
        f"private_key={b64_to_hex(conf['private_key'])}",
        "replace_peers=true",
        f"public_key={b64_to_hex(conf['public_key'])}",
        f"endpoint={conf['endpoint']}",
        f"persistent_keepalive_interval={conf['keepalive']}",
    ]
    for ip in conf["allowed_ips"]:
        body.append(f"allowed_ip={ip}")
    payload = "\n".join(body) + "\n\n"
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(5)
        sock.connect(sock_path(iface))
        sock.sendall(payload.encode("ascii"))
        reply = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            reply += chunk
            if b"\n\n" in reply:
                break
    finally:
        sock.close()
    text = reply.decode("ascii", errors="replace")
    if "errno=0" not in text:
        die(f"wireguard uapi failed: {text.strip()[:400]}")


def iface_exists(name: str) -> bool:
    if not name:
        return False
    out = run_out(["ifconfig", name])
    return bool(out) and "does not exist" not in out.lower()


def iface_up(name: str) -> bool:
    if not iface_exists(name):
        return False
    out = run_out(["ifconfig", name])
    return "status: active" in out.lower() or "inet " in out


def kill_wg_go() -> None:
    iface = current_iface()
    pid = None
    if os.path.isfile(PID_FILE):
        try:
            pid = int(open(PID_FILE, encoding="utf-8").read().strip())
        except Exception:
            pid = None
    if pid:
        try:
            os.kill(pid, 15)
            for _ in range(20):
                try:
                    os.kill(pid, 0)
                    time.sleep(0.1)
                except OSError:
                    break
            else:
                os.kill(pid, 9)
        except OSError:
            pass
        with contextlib.suppress(OSError):
            os.remove(PID_FILE)
    run(["pkill", "-f", "wireguard-go"], check=False)
    if iface:
        # Clear routes that pointed at the tunnel
        for net in ("0.0.0.0/1", "128.0.0.0/1"):
            run(["route", "-n", "delete", "-net", net], check=False)
        run(["ifconfig", iface, "down"], check=False)
    with contextlib.suppress(OSError):
        os.remove(IFACE_FILE)


def start_userspace(wg_go: str) -> str:
    """Start wireguard-go; returns utun iface name."""
    os.makedirs("/var/run/wireguard", exist_ok=True)
    os.makedirs(RUN_DIR, exist_ok=True)
    before = set()
    try:
        for name in os.listdir("/var/run/wireguard"):
            if name.endswith(".sock"):
                before.add(name[:-5])
    except OSError:
        pass
    proc = subprocess.Popen(
        [wg_go, "utun"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    with open(PID_FILE, "w", encoding="utf-8") as f:
        f.write(str(proc.pid))
    iface = ""
    for _ in range(80):
        try:
            for name in os.listdir("/var/run/wireguard"):
                if not name.endswith(".sock"):
                    continue
                cand = name[:-5]
                if cand.startswith("utun") and cand not in before:
                    iface = cand
                    break
        except OSError:
            pass
        if iface and iface_exists(iface):
            set_iface(iface)
            return iface
        time.sleep(0.1)
    die("wireguard-go did not create utun interface/socket")
    return ""


def apply_addr_routes(iface: str, conf: dict) -> None:
    addr = conf["address"].split("/")[0].strip()
    mtu = str(conf.get("mtu") or "1200")
    # Point-to-point style: local = peer for /32 tunnel IP
    run(["ifconfig", iface, "inet", addr, addr, "mtu", mtu, "up"], check=True)
    for net in conf["allowed_ips"]:
        # Prefer -interface so traffic goes into utun without needing a gateway
        p = run(
            ["route", "-n", "add", "-net", net, "-interface", iface],
            check=False,
            capture=True,
        )
        if p.returncode != 0:
            # Already exists → change
            run(
                ["route", "-n", "change", "-net", net, "-interface", iface],
                check=False,
            )


def cmd_up(args: list[str]) -> None:
    if len(args) < 1:
        die("up <conf> [wireguard-go|auto]")
    conf_path = args[0]
    wg_go = args[1] if len(args) > 1 and not args[1].startswith("-") else "auto"
    if not os.path.isfile(conf_path):
        die(f"conf not found: {conf_path}")
    conf = parse_conf(conf_path)
    kill_wg_go()
    time.sleep(0.2)

    userspace = None
    if wg_go and wg_go not in ("auto", "kernel", "-"):
        if os.path.isfile(wg_go) and os.access(wg_go, os.X_OK):
            userspace = wg_go
    if userspace is None:
        cand = shutil.which("wireguard-go")
        if cand:
            userspace = cand
    if not userspace:
        die("wireguard-go binary required on macOS")

    iface = start_userspace(userspace)
    uapi_set(iface, conf)
    apply_addr_routes(iface, conf)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        f.write("userspace\n")
    print("OK up", iface)


def cmd_down(_: list[str]) -> None:
    cmd_dns_restore([])
    kill_wg_go()
    print("OK down")


def cmd_status(_: list[str]) -> None:
    iface = current_iface()
    up = bool(iface) and iface_up(iface)
    print("up" if up else "down")
    sys.exit(0 if up else 1)


def cmd_gateway(_: list[str]) -> None:
    # route -n get default
    text = run_out(["route", "-n", "get", "default"])
    gw = ""
    iface = ""
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("gateway:"):
            gw = line.split(":", 1)[1].strip()
        elif line.startswith("interface:"):
            iface = line.split(":", 1)[1].strip()
    # If already tunneled, prefer non-utun default from netstat
    if iface.startswith("utun") or not gw:
        ns = run_out(["netstat", "-rn", "-f", "inet"])
        for line in ns.splitlines():
            parts = line.split()
            if len(parts) >= 4 and parts[0] == "default" and not parts[3].startswith("utun"):
                gw, iface = parts[1], parts[3]
                break
    if not gw or not iface or not _IPV4.match(gw):
        die("no physical default gateway")
    print(f"{gw} {iface}")


def cmd_bypass_add(args: list[str]) -> None:
    if len(args) < 3:
        die("bypass-add <gw> <iface> <cidr> [cidr...]")
    gw = args[0]
    ok = 0
    for cidr in args[2:]:
        dest = cidr if "/" in cidr else cidr + "/32"
        # Host route via physical gateway
        if dest.endswith("/32"):
            host = dest[:-3]
            p = run(["route", "-n", "add", "-host", host, gw], check=False, capture=True)
            if p.returncode != 0:
                p = run(["route", "-n", "change", "-host", host, gw], check=False, capture=True)
        else:
            p = run(["route", "-n", "add", "-net", dest, gw], check=False, capture=True)
            if p.returncode != 0:
                p = run(["route", "-n", "change", "-net", dest, gw], check=False, capture=True)
        if p.returncode == 0:
            ok += 1
    if ok < 1:
        die("bypass-add failed")
    print(f"OK bypass {ok}")


def cmd_bypass_del(args: list[str]) -> None:
    for cidr in args:
        dest = cidr if "/" in cidr else cidr + "/32"
        if dest.endswith("/32"):
            run(["route", "-n", "delete", "-host", dest[:-3]], check=False)
        else:
            run(["route", "-n", "delete", "-net", dest], check=False)
    print("OK bypass-del")


def _network_services() -> list[str]:
    out = run_out(["networksetup", "-listallnetworkservices"])
    services: list[str] = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("An asterisk") or line.startswith("*"):
            continue
        services.append(line)
    return services


def cmd_dns_set(args: list[str]) -> None:
    if len(args) < 2:
        die("dns-set <ifname> <dns,dns>")
    servers = [x.strip() for x in re.split(r"[,;\s]+", args[1]) if x.strip()]
    if not servers:
        return
    services = _network_services()
    prev: dict = {"services": {}}
    for svc in services:
        cur = run_out(["networksetup", "-getdnsservers", svc])
        if "There aren't any DNS Servers" in cur or not cur:
            prev["services"][svc] = ["Empty"]
        else:
            prev["services"][svc] = [x.strip() for x in cur.splitlines() if x.strip()]
        run(["networksetup", "-setdnsservers", svc, *servers], check=False)
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(DNS_STATE, "w", encoding="utf-8") as f:
        json.dump(prev, f)
    print("OK dns " + ",".join(servers) + " services=" + ",".join(services))


def cmd_dns_restore(_: list[str]) -> None:
    st: dict = {}
    if os.path.isfile(DNS_STATE):
        try:
            st = json.loads(open(DNS_STATE, encoding="utf-8").read() or "{}")
        except Exception:
            st = {}
    for svc, servers in (st.get("services") or {}).items():
        if not servers or servers == ["Empty"]:
            run(["networksetup", "-setdnsservers", svc, "Empty"], check=False)
        else:
            run(["networksetup", "-setdnsservers", svc, *servers], check=False)
    with contextlib.suppress(OSError):
        os.remove(DNS_STATE)
    print("OK dns-restore")


def _strip_hosts_block(text: str) -> str:
    out_lines: list[str] = []
    skip = False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped == HOSTS_MARK_BEGIN:
            skip = True
            continue
        if stripped == HOSTS_MARK_END:
            skip = False
            continue
        if not skip:
            out_lines.append(line)
    return "".join(out_lines)


def cmd_hosts_pin(args: list[str]) -> None:
    pairs: list[tuple[str, str]] = []
    for raw in args:
        m = _HOST_PAIR.match(raw.strip())
        if not m:
            die(f"bad hosts pair: {raw}")
        pairs.append((m.group(1), m.group(2)))
    if not pairs:
        return
    path = "/etc/hosts"
    try:
        prev = open(path, "r", encoding="utf-8", errors="replace").read()
    except OSError as e:
        die(f"hosts read: {e}")
    base = _strip_hosts_block(prev).rstrip() + "\n"
    block = [HOSTS_MARK_BEGIN + "\n"]
    seen: set[tuple[str, str]] = set()
    for ip, host in pairs:
        key = (ip, host)
        if key in seen:
            continue
        seen.add(key)
        block.append(f"{ip} {host}\n")
    block.append(HOSTS_MARK_END + "\n")
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(base)
            f.writelines(block)
        print(f"OK hosts-pin n={len(seen)}")
    except OSError as e:
        die(f"hosts write: {e}")


def cmd_hosts_restore(_: list[str]) -> None:
    path = "/etc/hosts"
    try:
        prev = open(path, "r", encoding="utf-8", errors="replace").read()
    except OSError as e:
        print(f"WARN hosts-restore: {e}")
        return
    if HOSTS_MARK_BEGIN not in prev:
        print("OK hosts-restore noop")
        return
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(_strip_hosts_block(prev))
        print("OK hosts-restore")
    except OSError as e:
        print(f"WARN hosts-restore: {e}")


def cmd_protect_on(args: list[str]) -> None:
    # On macOS WDTT binds LocalAddr to LAN IP (no SO_MARK). Keep gateway known.
    if len(args) < 2:
        die("protect-on <gw> <iface>")
    print(f"OK protect-on noop via {args[0]} dev {args[1]}")


def cmd_protect_off(_: list[str]) -> None:
    print("OK protect-off")


def cmd_ipv6_block(_: list[str]) -> None:
    os.makedirs(RUN_DIR, exist_ok=True)
    # Blackhole IPv6 default so apps prefer IPv4 via WG
    p = run(["route", "-n", "add", "-inet6", "::/0", "-blackhole"], check=False, capture=True)
    ok = p.returncode == 0 or "File exists" in ((p.stderr or "") + (p.stdout or ""))
    with open(IPV6_STATE, "w", encoding="utf-8") as f:
        json.dump({"blackhole": ok}, f)
    print("OK ipv6-block blackhole" if ok else "WARN ipv6-block")


def cmd_ipv6_restore(_: list[str]) -> None:
    st: dict = {}
    if os.path.isfile(IPV6_STATE):
        try:
            st = json.loads(open(IPV6_STATE, encoding="utf-8").read() or "{}")
        except Exception:
            st = {}
    if st.get("blackhole"):
        run(["route", "-n", "delete", "-inet6", "::/0", "-blackhole"], check=False)
    with contextlib.suppress(OSError):
        os.remove(IPV6_STATE)
    print("OK ipv6-restore")


COMMANDS = {
    "up": cmd_up,
    "down": cmd_down,
    "status": cmd_status,
    "gateway": cmd_gateway,
    "bypass-add": cmd_bypass_add,
    "bypass-del": cmd_bypass_del,
    "dns-set": cmd_dns_set,
    "dns-restore": cmd_dns_restore,
    "hosts-pin": cmd_hosts_pin,
    "hosts-restore": cmd_hosts_restore,
    "protect-on": cmd_protect_on,
    "protect-off": cmd_protect_off,
    "ipv6-block": cmd_ipv6_block,
    "ipv6-restore": cmd_ipv6_restore,
}


def conf_path_ok(path: str) -> bool:
    try:
        ap = os.path.realpath(path).replace("\\", "/")
    except OSError:
        return False
    if not ap.endswith(".conf"):
        return False
    home = os.path.expanduser("~")
    return (
        f"{home}/Library/Application Support/SilentVPN/" in ap
        or "/Library/Application Support/SilentVPN/" in ap
        or "/tmp/" in ap
        or "/var/folders/" in ap
        or ap.startswith("/var/run/silent-vpn/")
        or "/Applications/Silent VPN.app/" in ap
    )


def wg_go_path_ok(path: str) -> bool:
    if not path or path in ("auto", "kernel", "-"):
        return True
    try:
        ap = os.path.realpath(path)
    except OSError:
        return False
    if os.path.basename(ap) != "wireguard-go":
        return False
    return (
        "/Applications/Silent VPN.app/" in ap
        or ap.startswith("/usr/local/")
        or ap.startswith("/opt/")
        or "/resources/" in ap
    )


def validate_args(args: list[str]) -> str | None:
    if not args:
        return "empty command"
    cmd = args[0]
    if cmd not in COMMANDS:
        return f"unknown command: {cmd}"
    rest = args[1:]
    if cmd == "up":
        if not rest:
            return "up needs conf"
        if not conf_path_ok(rest[0]):
            return "conf path not allowed"
        if len(rest) > 1 and not wg_go_path_ok(rest[1]):
            return "wireguard-go path not allowed"
    elif cmd == "bypass-add":
        if len(rest) < 3:
            return "bypass-add needs gw iface cidr"
        if not _IPV4.match(rest[0]) or not _IFACE.match(rest[1]):
            return "invalid gw/iface"
        if not all(_CIDR.match(x) for x in rest[2:]):
            return "invalid cidr"
    elif cmd == "bypass-del":
        if not rest or not all(_CIDR.match(x) for x in rest):
            return "invalid cidr"
    elif cmd == "dns-set":
        if len(rest) < 2:
            return "dns-set needs args"
        servers = [x.strip() for x in re.split(r"[,;\s]+", rest[1]) if x.strip()]
        if not servers or not all(_IPV4.match(s) for s in servers):
            return "invalid dns"
    elif cmd == "hosts-pin":
        if not rest:
            return "hosts-pin needs pairs"
        if not all(_HOST_PAIR.match(x.strip()) for x in rest):
            return "invalid hosts pair"
    elif cmd == "protect-on":
        if len(rest) < 2:
            return "protect-on needs gw iface"
        if not _IPV4.match(rest[0]) or not _IFACE.match(rest[1]):
            return "invalid gw/iface"
    return None


def run_command(args: list[str]) -> tuple[int, str, str]:
    err = validate_args(args)
    if err:
        return 2, "", err
    out_buf = io.StringIO()
    err_buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(out_buf), contextlib.redirect_stderr(err_buf):
            COMMANDS[args[0]](args[1:])
        return 0, out_buf.getvalue(), err_buf.getvalue()
    except SystemExit as e:
        code = 0 if e.code in (0, None) else (e.code if isinstance(e.code, int) else 1)
        return code, out_buf.getvalue(), err_buf.getvalue()
    except Exception as e:
        return 1, out_buf.getvalue(), str(e)


def handle_client(conn: socket.socket) -> None:
    conn.settimeout(120)
    buf = b""
    try:
        while b"\n" not in buf:
            chunk = conn.recv(4096)
            if not chunk:
                return
            buf += chunk
            if len(buf) > 1_000_000:
                return
    except OSError:
        return
    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        return
    try:
        req = json.loads(line.decode("utf-8"))
        args = req.get("args")
        if not isinstance(args, list) or not all(isinstance(x, str) for x in args):
            raise ValueError("args")
        if len(args) > 128:
            raise ValueError("too many args")
    except Exception:
        payload = json.dumps({"ok": False, "code": 2, "out": "", "err": "bad request"}) + "\n"
        with contextlib.suppress(OSError):
            conn.sendall(payload.encode("utf-8"))
        return
    code, out, err = run_command(args)
    payload = json.dumps({"ok": code == 0, "code": code, "out": out, "err": err}) + "\n"
    with contextlib.suppress(OSError):
        conn.sendall(payload.encode("utf-8"))


def cmd_serve(_: list[str]) -> None:
    need_root()
    os.makedirs(RUN_DIR, exist_ok=True)
    with contextlib.suppress(OSError):
        os.remove(HELPER_SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(HELPER_SOCK)
    os.chmod(HELPER_SOCK, 0o666)
    srv.listen(8)
    while True:
        try:
            conn, _ = srv.accept()
        except OSError:
            continue
        try:
            handle_client(conn)
        finally:
            with contextlib.suppress(OSError):
                conn.close()


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        die(
            "silent-wg-helper <serve|up|down|status|gateway|"
            "bypass-add|bypass-del|dns-set|dns-restore> ..."
        )
    cmd = sys.argv[1]
    if cmd == "serve":
        cmd_serve([])
        return
    need_root()
    fn = COMMANDS.get(cmd)
    if not fn:
        die(f"unknown command: {cmd}")
    fn(sys.argv[2:])


if __name__ == "__main__":
    main()
