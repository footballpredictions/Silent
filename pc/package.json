{
  "name": "silent-vpn-pc",
  "version": "1.0.0",
  "description": "Silent VPN — PC Client",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --port 3001\" \"wait-on http://localhost:3001 && electron .\"",
    "build:renderer": "vite build --outDir dist/renderer",
    "setup:wireguard": "powershell -ExecutionPolicy Bypass -File scripts/setup-wireguard.ps1",
    "prebuild": "npm run setup:wireguard",
    "predist": "npm run setup:wireguard",
    "build": "npm run build:renderer && electron-builder",
    "dist": "npm run build"
  },
  "build": {
    "appId": "ru.silent.vpn",
    "productName": "Silent VPN",
    "directories": { "output": "dist/electron" },
    "extraResources": [
      { "from": "resources/wdtt-client.exe", "to": "wdtt-client.exe" },
      { "from": "resources/wireguard", "to": "wireguard", "filter": ["**/*"] }
    ],
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Silent VPN",
        "schemes": ["silentvpn"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  }
}
