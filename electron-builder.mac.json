{
  "appId": "ru.silent.vpn",
  "productName": "Silent VPN",
  "directories": {
    "output": "build-mac"
  },
  "artifactName": "Silent VPN Setup ${version}-${arch}.${ext}",
  "afterPack": "./scripts/mac-after-pack.js",
  "files": [
    "src/**",
    "dist/renderer/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/mac",
      "to": ".",
      "filter": ["wdtt-client", "silent-wg-helper", "wireguard-go"]
    },
    {
      "from": "assets/tray.png",
      "to": "assets/tray.png"
    },
    {
      "from": "assets/icon.png",
      "to": "assets/icon.png"
    }
  ],
  "mac": {
    "target": ["dmg"],
    "icon": "assets/icon.png",
    "category": "public.app-category.utilities",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null,
    "x64ArchFiles": "Contents/Resources/silent-wg-helper|Contents/Resources/assets/*",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "Silent VPN installs a privileged helper for the VPN tunnel."
    }
  },
  "dmg": {
    "title": "Silent VPN ${version}",
    "iconSize": 110,
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 140, "y": 190 },
      { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
    ]
  }
}
